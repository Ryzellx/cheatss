{
  "manifest_version": 2,
  "name": "Board Coach",
  "version": "1.3.0",
  "description": "Local engine overlay for chess boards.",
  "permissions": [
    "storage",
    "https://www.chess.com/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Board Coach"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "fen.js",
        "classify.js",
        "elo.js",
        "ui.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "stockfish.js",
    "bridge.js"
  ]
}